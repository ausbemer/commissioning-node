# Installed by ops/install.sh. Loads ONLY the commissioning_node nftables table (ADR-0002).
[Unit]
Description=commissioning-node firewall (MediaMTX + dashboard ports: tailnet + loopback only)
Before=network-pre.target mediamtx.service
Wants=network-pre.target
# Debian's nftables.service (disabled on this host) runs `flush ruleset`. If someone enables
# it, ordering after it keeps our table from being wiped at boot. A later manual restart of
# it still wipes it: ops/doctor.sh (as root) fails when the table is missing.
After=nftables.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f /etc/commissioning-node/firewall.nft
# This unit owns IPv4 forwarding (the subnet router, ADR-0005 A3): on only after the forward
# chain above is loaded, off before it is deleted, and off if the unit fails. A failed load
# never turns it on. Nothing in /etc/sysctl.d sets it, so a boot never forwards unfenced.
ExecStartPost=/usr/sbin/sysctl -q -w net.ipv4.ip_forward=1
ExecStop=/usr/sbin/sysctl -q -w net.ipv4.ip_forward=0
ExecStop=/usr/sbin/nft delete table inet commissioning_node
ExecStopPost=/usr/sbin/sysctl -q -w net.ipv4.ip_forward=0

[Install]
WantedBy=multi-user.target
